.DS_Store
themes/*
!themes/.gitignore

# Environment variables
.env
.env.local
.env.*.local

# Backups
backups/
*.sql
*.sql.gz
*.tar.gz

# SSL Certificates
nginx/certs/*
!nginx/certs/.gitkeep

# WordPress uploads
wordpress/

# Nginx config generado (los templates están en nginx/templates/)
nginx/conf.d/wordpress.conf
nginx/generated/

# PHP config generado desde .env
php-config/generated/

# Logs
*.log
logs/