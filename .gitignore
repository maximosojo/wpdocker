.DS_Store
themes/*
!themes/.gitignore

# Environment variables
.env
.env.local
.env.*.local

# Backups
backups/
*.sql
*.sql.gz
*.tar.gz

# SSL Certificates
nginx/certs/*
!nginx/certs/.gitkeep

# WordPress uploads
wordpress/

# Nginx config generado (los templates están en nginx/templates/)
nginx/conf.d/wordpress.conf
nginx/generated/*
!nginx/generated/.gitkeep
!nginx/generated/*.default

# PHP config generado desde .env
php-config/generated/*
!php-config/generated/.gitkeep
!php-config/generated/*.default

# Logs
*.log
logs/

*.old

nginx/conf.d/00-default.conf