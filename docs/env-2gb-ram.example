# =============================================================================
# Perfil para servidor 2 GB RAM + 2 CPU
# Total contenedores: ~1.15 GB (deja ~900 MB para sistema y picos).
# =============================================================================

NGINX_WORKER_PROCESSES=2
NGINX_WORKER_CONNECTIONS=1024
PHP_MEMORY_LIMIT=256M

DOCKER_MYSQL_CPU_LIMIT=1.0
DOCKER_MYSQL_CPU_RESERVE=0.4
DOCKER_MYSQL_MEMORY_LIMIT=512M
DOCKER_MYSQL_MEMORY_RESERVE=256M

DOCKER_WP_CPU_LIMIT=1.0
DOCKER_WP_CPU_RESERVE=0.4
DOCKER_WP_MEMORY_LIMIT=512M
DOCKER_WP_MEMORY_RESERVE=256M

DOCKER_NGINX_CPU_LIMIT=0.5
DOCKER_NGINX_CPU_RESERVE=0.2
DOCKER_NGINX_MEMORY_LIMIT=128M
DOCKER_NGINX_MEMORY_RESERVE=64M

MYSQL_INNODB_BUFFER_POOL_SIZE=320M
MYSQL_MAX_CONNECTIONS=50
MYSQL_TMP_TABLE_SIZE=32M
MYSQL_MAX_HEAP_TABLE_SIZE=32M

PHP_MAX_EXECUTION_TIME=300
PHP_MAX_INPUT_VARS=5000
