server {
    listen 80;
    server_name ${DOMAIN} www.${DOMAIN};
    
    # Configuración para Let's Encrypt (Certbot)
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }
    
    # Redirección a HTTPS (descomentar después de obtener el certificado SSL)
    # location / {
    #     return 301 https://$server_name$request_uri;
    # }
    
    # Configuración temporal para HTTP (hasta obtener SSL)
    location / {
        proxy_pass http://wordpress;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        
        # Buffers optimizados para recursos limitados
        proxy_buffer_size 16k;
        proxy_buffers 4 32k;
        proxy_busy_buffers_size 64k;
        proxy_temp_file_write_size 64k;
        
        # Timeouts: 60s para que PHP bajo carga no devuelva 502 (backend lento)
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
        
        # Keepalive para reducir overhead
        proxy_http_version 1.1;
        proxy_set_header Connection "";
    }
}

