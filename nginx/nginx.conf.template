# Nginx configuration template - optimizado para servidores con recursos limitados
# Variables: NGINX_WORKER_PROCESSES, NGINX_WORKER_CONNECTIONS

events {
    worker_connections ${NGINX_WORKER_CONNECTIONS:-512};
    use epoll;
    multi_accept on;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    # Workers dinámicos según CPU
    worker_processes ${NGINX_WORKER_PROCESSES:-2};
    
    # Logging optimizado
    access_log off;
    error_log /var/log/nginx/error.log warn;
    
    # Buffers optimizados para recursos limitados
    client_body_buffer_size 16k;
    client_header_buffer_size 1k;
    large_client_header_buffers 2 4k;
    client_max_body_size 64m;
    
    # Timeouts reducidos para evitar conexiones colgadas
    client_body_timeout 12;
    client_header_timeout 12;
    keepalive_timeout 15;
    send_timeout 10;
    
    # Compresión (ahorra ancho de banda)
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types text/plain text/css text/xml text/javascript application/json application/javascript application/xml+rss application/rss+xml font/truetype font/opentype application/vnd.ms-fontobject image/svg+xml;
    gzip_disable "msie6";
    
    # Cache de archivos estáticos
    open_file_cache max=1000 inactive=20s;
    open_file_cache_valid 30s;
    open_file_cache_min_uses 2;
    open_file_cache_errors on;
    
    # Upstream con keepalive para reducir conexiones
    upstream wordpress {
        server wordpress:80;
        keepalive 8;
    }

    # Configuración del servidor (HTTP y HTTPS)
    include /etc/nginx/conf.d/*.conf;
}
