# =============================================================================
# WordPress Docker — Configuración de despliegue
# =============================================================================
# Copia este archivo a .env y rellena los valores. Solo con .env configurado
# puedes desplegar en cualquier servidor (./scripts/setup.sh && docker-compose up -d).
# No subas .env a Git.
# =============================================================================

# Identificador del proyecto (nombres de contenedores: <PROYECTO>_wordpress_mysql, etc.)
COMPOSE_PROJECT_NAME=wpdocker

# Dominio del sitio (usado en Nginx server_name). Para local: localhost o 127.0.0.1
DOMAIN=localhost

# -----------------------------------------------------------------------------
# Base de datos MySQL
# -----------------------------------------------------------------------------
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=wordpress_db
MYSQL_USER=wordpress_user
MYSQL_PASSWORD=

# -----------------------------------------------------------------------------
# WordPress (debe coincidir con DB)
# -----------------------------------------------------------------------------
WORDPRESS_DB_HOST=db:3306
WORDPRESS_DB_NAME=wordpress_db
WORDPRESS_DB_USER=wordpress_user
WORDPRESS_DB_PASSWORD=
WORDPRESS_DEBUG=false

# -----------------------------------------------------------------------------
# Puertos en el host (80/443 o alternativos si ya están en uso)
# -----------------------------------------------------------------------------
HTTP_PORT=80
HTTPS_PORT=443

# -----------------------------------------------------------------------------
# Recursos Docker — perfil estable 2 GB RAM (ver docs/env-2gb-ram.example)
# En servidores de 1 GB usar ./scripts/detect-resources.sh
# Arrancar siempre con: ./scripts/up.sh
# -----------------------------------------------------------------------------
DOCKER_MYSQL_CPU_LIMIT=1.0
DOCKER_MYSQL_CPU_RESERVE=0.4
DOCKER_MYSQL_MEMORY_LIMIT=512M
DOCKER_MYSQL_MEMORY_RESERVE=256M

DOCKER_WP_CPU_LIMIT=1.0
DOCKER_WP_CPU_RESERVE=0.4
DOCKER_WP_MEMORY_LIMIT=512M
DOCKER_WP_MEMORY_RESERVE=256M

DOCKER_NGINX_CPU_LIMIT=0.5
DOCKER_NGINX_CPU_RESERVE=0.2
DOCKER_NGINX_MEMORY_LIMIT=128M
DOCKER_NGINX_MEMORY_RESERVE=64M

# -----------------------------------------------------------------------------
# Optimizaciones MySQL (perfil 2 GB)
# -----------------------------------------------------------------------------
MYSQL_INNODB_BUFFER_POOL_SIZE=320M
MYSQL_MAX_CONNECTIONS=50
MYSQL_TMP_TABLE_SIZE=32M
MYSQL_MAX_HEAP_TABLE_SIZE=32M

# -----------------------------------------------------------------------------
# Optimizaciones PHP
# -----------------------------------------------------------------------------
PHP_MEMORY_LIMIT=256M
PHP_MAX_EXECUTION_TIME=300
PHP_MAX_INPUT_VARS=5000

# -----------------------------------------------------------------------------
# Optimizaciones Nginx
# -----------------------------------------------------------------------------
NGINX_WORKER_PROCESSES=2
NGINX_WORKER_CONNECTIONS=1024

# -----------------------------------------------------------------------------
# SSL (opcional; para habilitar HTTPS descomenta el bloque server 443 en
# nginx/conf.d/wordpress.conf después de generar con setup.sh y pon aquí las rutas)
# Las rutas son dentro del contenedor nginx: /etc/nginx/certs/...
# SSL_CERTIFICATE=/etc/nginx/certs/fullchain.pem
# SSL_CERTIFICATE_KEY=/etc/nginx/certs/privkey.pem
